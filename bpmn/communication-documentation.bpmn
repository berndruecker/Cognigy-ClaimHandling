<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CommunicationDocumentation" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="communicationDocumentation" name="Communication &#38; Documentation" isExecutable="true">
    <bpmn:documentation>Workflow 6 of 6 in the claim-handling sequence. Generates the claim folder, the compliance audit entry, schedules the adjuster callback, and sends Sarah a status SMS. Called from claim-handling.bpmn.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_CommunicationDocumentation" name="Communication &#38; documentation requested">
      <bpmn:outgoing>Flow_ToGenerateClaimFolder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="GenerateClaimFolder" name="Generate claim folder">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this creates the claim folder in the document management system and sets claimFolderId.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-claim-folder" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGenerateClaimFolder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateAuditEntry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CreateComplianceAuditEntry" name="Create compliance audit entry">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this writes the regulatory audit trail entry and sets auditEntryId.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-compliance-audit-entry" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateAuditEntry</bpmn:incoming>
      <bpmn:outgoing>Flow_ToScheduleCallback</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ScheduleAdjusterCallback" name="Schedule adjuster callback">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this books the adjuster's callback window.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="schedule-adjuster-callback" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScheduleCallback</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendStatusSms</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SendStatusSms" name="Send status SMS">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this sends Sarah the claim ID and tracking link, and sets smsSent (boolean).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-status-sms" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendStatusSms</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_CommunicationDocumentation" name="Communication &#38; documentation complete">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToGenerateClaimFolder" sourceRef="StartEvent_CommunicationDocumentation" targetRef="GenerateClaimFolder" />
    <bpmn:sequenceFlow id="Flow_ToCreateAuditEntry" sourceRef="GenerateClaimFolder" targetRef="CreateComplianceAuditEntry" />
    <bpmn:sequenceFlow id="Flow_ToScheduleCallback" sourceRef="CreateComplianceAuditEntry" targetRef="ScheduleAdjusterCallback" />
    <bpmn:sequenceFlow id="Flow_ToSendStatusSms" sourceRef="ScheduleAdjusterCallback" targetRef="SendStatusSms" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="SendStatusSms" targetRef="EndEvent_CommunicationDocumentation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CommunicationDocumentation">
    <bpmndi:BPMNPlane id="BPMNPlane_CommunicationDocumentation" bpmnElement="communicationDocumentation">
      <bpmndi:BPMNShape id="StartEvent_CommunicationDocumentation_di" bpmnElement="StartEvent_CommunicationDocumentation">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GenerateClaimFolder_di" bpmnElement="GenerateClaimFolder">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateComplianceAuditEntry_di" bpmnElement="CreateComplianceAuditEntry">
        <dc:Bounds x="440" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScheduleAdjusterCallback_di" bpmnElement="ScheduleAdjusterCallback">
        <dc:Bounds x="640" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendStatusSms_di" bpmnElement="SendStatusSms">
        <dc:Bounds x="840" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CommunicationDocumentation_di" bpmnElement="EndEvent_CommunicationDocumentation">
        <dc:Bounds x="1072" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToGenerateClaimFolder_di" bpmnElement="Flow_ToGenerateClaimFolder">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCreateAuditEntry_di" bpmnElement="Flow_ToCreateAuditEntry">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="440" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToScheduleCallback_di" bpmnElement="Flow_ToScheduleCallback">
        <di:waypoint x="540" y="120" />
        <di:waypoint x="640" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSendStatusSms_di" bpmnElement="Flow_ToSendStatusSms">
        <di:waypoint x="740" y="120" />
        <di:waypoint x="840" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="940" y="120" />
        <di:waypoint x="1072" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
