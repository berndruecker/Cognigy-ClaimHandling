<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CoverageAssessment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="coverageAssessment" name="Coverage Assessment" isExecutable="true">
    <bpmn:documentation>Workflow 2 of 6 in the claim-handling sequence. Applies DMN business rules to determine coverage %, deductible, reserve amount, and the high-value flag. Called from claim-handling.bpmn.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_CoverageAssessment" name="Coverage assessment requested">
      <bpmn:outgoing>Flow_ToDetermineCoverage</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="DetermineCoverage" name="Determine coverage &#38; reserve">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=claim.coverage_type" target="coverage_type" />
          <zeebe:input source="=claim.policy_tier" target="policy_tier" />
          <zeebe:input source="=claim.estimated_loss" target="estimated_loss" />
        </zeebe:ioMapping>
        <zeebe:calledDecision decisionId="coverageAssessment" resultVariable="coverageAssessment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetermineCoverage</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="EndEvent_CoverageAssessment" name="Coverage assessed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToDetermineCoverage" sourceRef="StartEvent_CoverageAssessment" targetRef="DetermineCoverage" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="DetermineCoverage" targetRef="EndEvent_CoverageAssessment" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CoverageAssessment">
    <bpmndi:BPMNPlane id="BPMNPlane_CoverageAssessment" bpmnElement="coverageAssessment">
      <bpmndi:BPMNShape id="StartEvent_CoverageAssessment_di" bpmnElement="StartEvent_CoverageAssessment">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CoverageAssessment_di" bpmnElement="EndEvent_CoverageAssessment">
        <dc:Bounds x="472" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineCoverage_di" bpmnElement="DetermineCoverage">
        <dc:Bounds x="280" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToDetermineCoverage_di" bpmnElement="Flow_ToDetermineCoverage">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="280" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="380" y="120" />
        <di:waypoint x="472" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
