<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PolicyValidation" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="policyValidation" name="Policy Validation" isExecutable="true">
    <bpmn:documentation>Workflow 1 of 6 in the claim-handling sequence. Verifies the policy is active, coverage limits apply, and no exclusions block the claim. Called from claim-handling.bpmn.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_PolicyValidation" name="Policy validation requested">
      <bpmn:outgoing>Flow_ToCheckPolicyStatus</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CheckPolicyStatus" name="Check policy status">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this looks up customer.policy_number and sets policy_status (ACTIVE|LAPSED|CANCELLED) and exclusions_apply (boolean) for the decision below, using claim.coverage_type to check exclusions.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-policy-status" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheckPolicyStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEvaluateEligibility</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="EvaluateEligibility" name="Evaluate eligibility">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="policyEligibility" resultVariable="policyEligibility" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEvaluateEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="EndEvent_PolicyValidation" name="Policy validated">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCheckPolicyStatus" sourceRef="StartEvent_PolicyValidation" targetRef="CheckPolicyStatus" />
    <bpmn:sequenceFlow id="Flow_ToEvaluateEligibility" sourceRef="CheckPolicyStatus" targetRef="EvaluateEligibility" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="EvaluateEligibility" targetRef="EndEvent_PolicyValidation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PolicyValidation">
    <bpmndi:BPMNPlane id="BPMNPlane_PolicyValidation" bpmnElement="policyValidation">
      <bpmndi:BPMNShape id="StartEvent_PolicyValidation_di" bpmnElement="StartEvent_PolicyValidation">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckPolicyStatus_di" bpmnElement="CheckPolicyStatus">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EvaluateEligibility_di" bpmnElement="EvaluateEligibility">
        <dc:Bounds x="440" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PolicyValidation_di" bpmnElement="EndEvent_PolicyValidation">
        <dc:Bounds x="672" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCheckPolicyStatus_di" bpmnElement="Flow_ToCheckPolicyStatus">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEvaluateEligibility_di" bpmnElement="Flow_ToEvaluateEligibility">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="440" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="540" y="120" />
        <di:waypoint x="672" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
