<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_EmergencyResponseCoordination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="emergencyResponseCoordination" name="Emergency Response Coordination" isExecutable="true">
    <bpmn:documentation>Workflow 5 of 6 in the claim-handling sequence. Determines whether emergency mitigation is needed and, if so, coordinates vendor dispatch. Called from claim-handling.bpmn.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_EmergencyResponseCoordination" name="Emergency response requested">
      <bpmn:outgoing>Flow_ToDetermineMitigationNeed</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="DetermineMitigationNeed" name="Determine mitigation need">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=claim.coverage_type" target="coverage_type" />
          <zeebe:input source="=claim.hazards_identified" target="hazards_identified" />
          <zeebe:input source="=claim.safety_concern" target="safety_concern" />
          <zeebe:output source="=emergencyMitigation" target="emergencyMitigation" />
          <zeebe:output source="=emergencyMitigation.mitigation_required" target="mitigationRequired" />
        </zeebe:ioMapping>
        <zeebe:calledDecision decisionId="emergencyMitigation" resultVariable="emergencyMitigation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetermineMitigationNeed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMitigationGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="MitigationNeededGateway" name="Mitigation needed?" default="Flow_NoMitigationNeeded">
      <bpmn:incoming>Flow_ToMitigationGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_MitigationNeeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoMitigationNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ContactVendorNetwork" name="Contact vendor network">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this contacts the preferred mitigation vendor network for emergencyMitigation.vendor_type.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contact-vendor-network" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MitigationNeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAuthorizeDispatch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AuthorizeEmergencyDispatch" name="Authorize emergency dispatch">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this authorizes the vendor dispatch and sets vendorDispatched (boolean).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="authorize-emergency-dispatch" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAuthorizeDispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCaptureCost</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CaptureMitigationCost" name="Capture mitigation cost">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this records the vendor's quoted/actual cost and sets mitigationCost (number).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="capture-mitigation-cost" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCaptureCost</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyCustomer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NotifyCustomerSms" name="Notify customer via SMS">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this sends Sarah a real-time SMS that emergency mitigation has been dispatched.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer-sms" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToJoinGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="MitigationJoinGateway">
      <bpmn:incoming>Flow_ToJoinGateway</bpmn:incoming>
      <bpmn:incoming>Flow_NoMitigationNeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_EmergencyResponseCoordination" name="Emergency response coordinated">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToDetermineMitigationNeed" sourceRef="StartEvent_EmergencyResponseCoordination" targetRef="DetermineMitigationNeed" />
    <bpmn:sequenceFlow id="Flow_ToMitigationGateway" sourceRef="DetermineMitigationNeed" targetRef="MitigationNeededGateway" />
    <bpmn:sequenceFlow id="Flow_MitigationNeeded" name="Yes" sourceRef="MitigationNeededGateway" targetRef="ContactVendorNetwork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=mitigationRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoMitigationNeeded" name="No" sourceRef="MitigationNeededGateway" targetRef="MitigationJoinGateway" />
    <bpmn:sequenceFlow id="Flow_ToAuthorizeDispatch" sourceRef="ContactVendorNetwork" targetRef="AuthorizeEmergencyDispatch" />
    <bpmn:sequenceFlow id="Flow_ToCaptureCost" sourceRef="AuthorizeEmergencyDispatch" targetRef="CaptureMitigationCost" />
    <bpmn:sequenceFlow id="Flow_ToNotifyCustomer" sourceRef="CaptureMitigationCost" targetRef="NotifyCustomerSms" />
    <bpmn:sequenceFlow id="Flow_ToJoinGateway" sourceRef="NotifyCustomerSms" targetRef="MitigationJoinGateway" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="MitigationJoinGateway" targetRef="EndEvent_EmergencyResponseCoordination" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_EmergencyResponseCoordination">
    <bpmndi:BPMNPlane id="BPMNPlane_EmergencyResponseCoordination" bpmnElement="emergencyResponseCoordination">
      <bpmndi:BPMNShape id="StartEvent_EmergencyResponseCoordination_di" bpmnElement="StartEvent_EmergencyResponseCoordination">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineMitigationNeed_di" bpmnElement="DetermineMitigationNeed">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MitigationNeededGateway_di" bpmnElement="MitigationNeededGateway" isMarkerVisible="true">
        <dc:Bounds x="390" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="426" y="136" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ContactVendorNetwork_di" bpmnElement="ContactVendorNetwork">
        <dc:Bounds x="490" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AuthorizeEmergencyDispatch_di" bpmnElement="AuthorizeEmergencyDispatch">
        <dc:Bounds x="640" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CaptureMitigationCost_di" bpmnElement="CaptureMitigationCost">
        <dc:Bounds x="790" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyCustomerSms_di" bpmnElement="NotifyCustomerSms">
        <dc:Bounds x="940" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MitigationJoinGateway_di" bpmnElement="MitigationJoinGateway" isMarkerVisible="true">
        <dc:Bounds x="1090" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_EmergencyResponseCoordination_di" bpmnElement="EndEvent_EmergencyResponseCoordination">
        <dc:Bounds x="1182" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToDetermineMitigationNeed_di" bpmnElement="Flow_ToDetermineMitigationNeed">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToMitigationGateway_di" bpmnElement="Flow_ToMitigationGateway">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MitigationNeeded_di" bpmnElement="Flow_MitigationNeeded">
        <di:waypoint x="440" y="120" />
        <di:waypoint x="490" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoMitigationNeeded_di" bpmnElement="Flow_NoMitigationNeeded">
        <di:waypoint x="415" y="145" />
        <di:waypoint x="415" y="250" />
        <di:waypoint x="1115" y="250" />
        <di:waypoint x="1115" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAuthorizeDispatch_di" bpmnElement="Flow_ToAuthorizeDispatch">
        <di:waypoint x="590" y="120" />
        <di:waypoint x="640" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCaptureCost_di" bpmnElement="Flow_ToCaptureCost">
        <di:waypoint x="740" y="120" />
        <di:waypoint x="790" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNotifyCustomer_di" bpmnElement="Flow_ToNotifyCustomer">
        <di:waypoint x="890" y="120" />
        <di:waypoint x="940" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToJoinGateway_di" bpmnElement="Flow_ToJoinGateway">
        <di:waypoint x="1040" y="120" />
        <di:waypoint x="1090" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="1140" y="120" />
        <di:waypoint x="1182" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>