<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_FraudDetection" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="fraudDetection" name="Fraud Detection" isExecutable="true">
    <bpmn:documentation>Workflow 3 of 6 in the claim-handling sequence. Pattern-matches prior claims and timing, checks the fraud database, and scores risk. Called from claim-handling.bpmn.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_FraudDetection" name="Fraud detection requested">
      <bpmn:outgoing>Flow_ToCheckPriorClaims</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CheckPriorClaims" name="Check prior claims on property">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this looks up claim history for the property/customer and sets prior_claims_count and timing_anomaly_days for the decision below.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-prior-claims" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheckPriorClaims</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckFraudDatabase</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CheckFraudDatabase" name="Check fraud database">
      <bpmn:documentation>Placeholder — no worker implemented yet. In production this queries an external fraud database and sets fraud_database_hit (boolean) for the decision below.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-fraud-database" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheckFraudDatabase</bpmn:incoming>
      <bpmn:outgoing>Flow_ToScoreFraudIndicators</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="ScoreFraudIndicators" name="Score fraud indicators">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="fraudRiskIndicators" resultVariable="fraudIndicators" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScoreFraudIndicators</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLlmRiskAssessment</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="LlmRiskAssessment" name="Assess fraud risk with LLM reasoning">
      <bpmn:documentation>Placeholder — no worker implemented yet. This is the future AI Agent hook (see camunda-ai-agents skill): a later phase replaces this task with an AI Agent sub-process that reasons over fraudIndicators.preliminary_risk_level plus the free-text claim description and conversation sentiment to confirm or escalate the risk band. Must complete with fraudRiskLevel (LOW|MEDIUM|HIGH) — for now that can simply echo fraudIndicators.preliminary_risk_level.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="llm-fraud-risk-assessment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLlmRiskAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_FraudDetection" name="Fraud risk scored">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCheckPriorClaims" sourceRef="StartEvent_FraudDetection" targetRef="CheckPriorClaims" />
    <bpmn:sequenceFlow id="Flow_ToCheckFraudDatabase" sourceRef="CheckPriorClaims" targetRef="CheckFraudDatabase" />
    <bpmn:sequenceFlow id="Flow_ToScoreFraudIndicators" sourceRef="CheckFraudDatabase" targetRef="ScoreFraudIndicators" />
    <bpmn:sequenceFlow id="Flow_ToLlmRiskAssessment" sourceRef="ScoreFraudIndicators" targetRef="LlmRiskAssessment" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="LlmRiskAssessment" targetRef="EndEvent_FraudDetection" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FraudDetection">
    <bpmndi:BPMNPlane id="BPMNPlane_FraudDetection" bpmnElement="fraudDetection">
      <bpmndi:BPMNShape id="StartEvent_FraudDetection_di" bpmnElement="StartEvent_FraudDetection">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckPriorClaims_di" bpmnElement="CheckPriorClaims">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckFraudDatabase_di" bpmnElement="CheckFraudDatabase">
        <dc:Bounds x="440" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScoreFraudIndicators_di" bpmnElement="ScoreFraudIndicators">
        <dc:Bounds x="640" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LlmRiskAssessment_di" bpmnElement="LlmRiskAssessment">
        <dc:Bounds x="840" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_FraudDetection_di" bpmnElement="EndEvent_FraudDetection">
        <dc:Bounds x="1072" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCheckPriorClaims_di" bpmnElement="Flow_ToCheckPriorClaims">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCheckFraudDatabase_di" bpmnElement="Flow_ToCheckFraudDatabase">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="440" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToScoreFraudIndicators_di" bpmnElement="Flow_ToScoreFraudIndicators">
        <di:waypoint x="540" y="120" />
        <di:waypoint x="640" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLlmRiskAssessment_di" bpmnElement="Flow_ToLlmRiskAssessment">
        <di:waypoint x="740" y="120" />
        <di:waypoint x="840" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="940" y="120" />
        <di:waypoint x="1072" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
